# ===== Afiliacja: Awin =====
# ID wydawcy (publisher) w Awin — znajdziesz je w panelu Awin po założeniu konta.
AWIN_PUBLISHER_ID=

# Token API do Awin Product Feed (opcjonalny — do pobierania danych produktów).
AWIN_API_TOKEN=

# ===== Afiliacja: Ceneo (program Ceneo Aff) =====
# Klucz API Ceneo.
CENEO_API_KEY=

# Bazowy adres API Ceneo (opcjonalny, ustawiony domyślny).
CENEO_BASE_URL=https://apigateway.ceneo.pl

# ===== Bezpieczeństwo cloakowania (/api/click) =====
# Lista dozwolonych domen sklepów (rozdzielone przecinkiem), na które może
# prowadzić przekierowanie. Chroni przed open-redirect.
ALLOWED_RETAILER_DOMAINS=castorama.pl,leroymerlin.pl,obi.pl,x-kom.pl,mediaexpert.pl,morele.net,euro.com.pl
