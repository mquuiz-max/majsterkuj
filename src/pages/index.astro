---
import Layout from '../layouts/Layout.astro';
import { rooms, standards, tools } from '../data/renovation';
import { buildCloakedClickUrl } from '../lib/affiliate/links';

// Mapowanie narzędzi na cloakowane linki afiliacyjne.
// Gdy `affiliateUrl` to prawdziwy adres (http...), budujemy /api/click?to=...
// Gdy to placeholder "#", link = null (wyświetlamy "Wkrótce").
const toolLinks: Record<string, string | null> = Object.fromEntries(
  tools.map((tool) => {
    const isReal = typeof tool.affiliateUrl === 'string' && tool.affiliateUrl.startsWith('http');
    return [
      tool.id,
      isReal ? buildCloakedClickUrl({ destinationUrl: tool.affiliateUrl, clickref: tool.id }) : null,
    ];
  }),
);

const pageTitle = 'Kalkulator kosztów remontu';
const pageDescription =
  'Oblicz koszt remontu lub wykończenia pomieszczenia. Podaj metraż i standard, a otrzymasz kosztorys robocizny i materiałów oraz listę potrzebnych narzędzi.';

const faq = [
  {
    q: 'Ile kosztuje remont łazienki?',
    a: 'Łazienka to zwykle najdroższe pomieszczenie — przyjmujemy średnio około 2800 zł/m² w standardzie „standardowy". Ostateczny koszt zależy od metrażu, standardu wykończenia i zakresu prac.',
  },
  {
    q: 'Ile kosztuje remont mieszkania 50 m²?',
    a: 'Remont całego mieszkania najłatwiej oszacować, sumując koszty poszczególnych pomieszczeń: łazienki, kuchni, salonu, sypialni i przedpokoju. Podaj metraż każdego z nich w kalkulatorze, aby otrzymać łączny przedział.',
  },
  {
    q: 'Czy szacunek uwzględnia robociznę i materiały?',
    a: 'Tak. Kalkulator rozdziela koszt na robociznę i materiały, a wynik podaje jako przedział. Stawki są orientacyjne i mogą się różnić w zależności od lokalizacji i wykonawcy.',
  },
  {
    q: 'Jakie narzędzia przydadzą się do remontu?',
    a: 'Kalkulator na podstawie wybranego zakresu prac pokazuje listę potrzebnych narzędzi, np. wiertarko-wkrętarkę, szlifierkę kątową, poziomicę laserową czy zestaw malarski, wraz z orientacyjnymi cenami.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};

const schema = JSON.stringify(faqSchema);
---

<Layout title={pageTitle} description={pageDescription} canonicalPath="/" schema={schema}>
  <section class="border-b border-slate-200 bg-gradient-to-b from-orange-50 via-white to-white">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:py-16">
      <span class="inline-flex items-center gap-2 rounded-full bg-orange-100 px-3 py-1 text-xs font-semibold text-orange-700">
        🔧 Darmowy kosztorys online
      </span>
      <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-5xl">
        Kalkulator kosztów remontu
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-600">
        Wybierz pomieszczenie, podaj metraż i standard wykończenia. Otrzymasz szacunkowy kosztorys
        (robocizna + materiały) oraz listę narzędzi, które przydadzą się do pracy.
      </p>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-slate-500">
        <span class="flex items-center gap-1.5"><span class="text-orange-500">✓</span> Robocizna i materiały</span>
        <span class="flex items-center gap-1.5"><span class="text-orange-500">🛠️</span> Lista narzędzi</span>
        <span class="flex items-center gap-1.5"><span class="text-orange-500">⚡</span> Wynik od ręki</span>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10">
    <div class="grid gap-8 lg:grid-cols-5">
      <form id="calculator" class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm lg:col-span-2">
        <label class="block text-sm font-semibold text-slate-700" for="room">1. Pomieszczenie</label>
        <select
          id="room"
          name="room"
          class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-200"
        >
          {rooms.map((room) => <option value={room.id}>{room.emoji} {room.name}</option>)}
        </select>

        <label class="mt-6 block text-sm font-semibold text-slate-700" for="area">2. Metraż (m²)</label>
        <input
          id="area"
          name="area"
          type="number"
          min="1"
          max="500"
          step="0.5"
          value="20"
          class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-200"
        />

        <fieldset class="mt-6">
          <legend class="text-sm font-semibold text-slate-700">3. Standard wykończenia</legend>
          <div class="mt-2 space-y-2">
            {standards.map((standard, i) => (
              <label class="flex cursor-pointer items-start gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2.5">
                <input type="radio" name="standard" value={standard.id} checked={i === 1} class="mt-1 accent-orange-600" />
                <span>
                  <span class="block text-sm font-medium text-slate-800">{standard.name}</span>
                  <span class="block text-xs text-slate-500">{standard.description}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="mt-6">
          <legend class="text-sm font-semibold text-slate-700">4. Zakres prac</legend>
          <div id="works" class="mt-2 space-y-1.5">
            <!-- wypełniane przez JavaScript -->
          </div>
        </fieldset>

        <button
          type="submit"
          class="mt-6 w-full rounded-xl bg-gradient-to-r from-orange-600 to-amber-500 px-4 py-3 font-semibold text-white shadow-sm transition-all hover:shadow-md hover:brightness-105 focus:outline-none focus:ring-2 focus:ring-orange-400 focus:ring-offset-2"
        >
          Oblicz koszt
        </button>
      </form>

      <div class="lg:col-span-3">
        <div id="result" class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-slate-500">Ładowanie…</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-10">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Najczęściej zadawane pytania</h2>
    <div class="mt-6 space-y-4">
      {faq.map((item) => (
        <details class="rounded-2xl border border-slate-200 bg-white p-5">
          <summary class="cursor-pointer list-none font-semibold text-slate-800">
            {item.q}
          </summary>
          <p class="mt-3 text-slate-600">{item.a}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>

<script define:vars={{ rooms, standards, tools, toolLinks }}>
  const form = document.getElementById('calculator');
  const roomSelect = document.getElementById('room');
  const areaInput = document.getElementById('area');
  const resultEl = document.getElementById('result');
  const worksEl = document.getElementById('works');

  const currency = new Intl.NumberFormat('pl-PL', {
    style: 'currency',
    currency: 'PLN',
    maximumFractionDigits: 0,
  });

  function toolById(id) {
    return tools.find((t) => t.id === id);
  }

  function currentRoom() {
    return rooms.find((r) => r.id === roomSelect.value);
  }

  function renderWorks() {
    const room = currentRoom();
    if (!room) return;
    worksEl.innerHTML = room.works
      .map(
        (w) => `
        <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2">
          <input type="checkbox" name="work" value="${w.id}" checked class="h-4 w-4 accent-orange-600" />
          <span class="text-sm text-slate-700">${w.label}</span>
        </label>`,
      )
      .join('');
  }

  function selectedWorks(room) {
    const boxes = form.querySelectorAll('input[name="work"]:checked');
    const ids = new Set(Array.from(boxes).map((b) => b.value));
    return room.works.filter((w) => ids.has(w.id));
  }

  function calculate(roomId, area, standardId) {
    const room = rooms.find((r) => r.id === roomId);
    const standard = standards.find((s) => s.id === standardId);
    const areaNum = Number(area);
    if (!room || !standard || !areaNum || areaNum <= 0) return null;

    const selected = selectedWorks(room);
    const share = selected.reduce((sum, w) => sum + w.share, 0);

    const costPerM2 = room.baseCostPerM2 * standard.multiplier;
    const mid = areaNum * costPerM2 * share;
    const low = mid * 0.85;
    const high = mid * 1.15;
    const labor = mid * room.laborShare;
    const materials = mid * (1 - room.laborShare);
    const toolIds = [...new Set(selected.flatMap((w) => w.toolIds))];
    const toolList = toolIds.map(toolById).filter(Boolean);

    return { room, standard, area: areaNum, selected, share, low, high, labor, materials, toolList };
  }

  function renderResult(data) {
    if (!data) {
      resultEl.innerHTML =
        '<p class="text-slate-500">Podaj poprawny metraż (większy od 0), aby zobaczyć kosztorys.</p>';
      return;
    }

    const { room, standard, area, selected, low, high, labor, materials, toolList } = data;

    if (selected.length === 0) {
      resultEl.innerHTML =
        '<p class="text-slate-500">Zaznacz przynajmniej jedną pracę w sekcji "Zakres prac".</p>';
      return;
    }

    const toolsHtml = toolList
      .map((tool) => {
        const link = toolLinks[tool.id];
        const action = link
          ? `<a
              href="${link}"
              rel="sponsored nofollow noopener"
              target="_blank"
              class="shrink-0 rounded-lg bg-orange-50 px-3 py-1.5 text-sm font-semibold text-orange-700 transition-colors hover:bg-orange-100"
            >Zobacz cenę</a>`
          : `<span class="shrink-0 rounded-lg bg-slate-100 px-3 py-1.5 text-sm font-medium text-slate-400">Wkrótce</span>`;
        return `
        <li class="flex items-center justify-between gap-4 border-b border-slate-100 py-3">
          <div>
            <p class="font-medium text-slate-800">${tool.name}</p>
            <p class="text-xs text-slate-500">${tool.category} · orientacyjnie ${tool.priceRange}</p>
          </div>
          ${action}
        </li>`;
      })
      .join('');

    resultEl.innerHTML = `
      <div class="flex items-center gap-3">
        <span class="text-4xl" aria-hidden="true">${room.emoji}</span>
        <div>
          <h2 class="text-xl font-bold text-slate-900">Remont: ${room.name}</h2>
          <p class="text-sm text-slate-500">${area} m² · standard ${standard.name.toLowerCase()}</p>
        </div>
      </div>

      <div class="mt-5 rounded-xl bg-orange-50 p-5 text-center">
        <p class="text-sm font-medium text-orange-700">Szacunkowy koszt całkowity</p>
        <p class="mt-1 text-3xl font-bold text-slate-900">${currency.format(low)} – ${currency.format(high)}</p>
      </div>

      <div class="mt-5 grid grid-cols-2 gap-4">
        <div class="rounded-xl border border-slate-200 p-4">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Robocizna</p>
          <p class="mt-1 text-lg font-semibold text-slate-900">${currency.format(labor)}</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-4">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Materiały</p>
          <p class="mt-1 text-lg font-semibold text-slate-900">${currency.format(materials)}</p>
        </div>
      </div>

      <div class="mt-5">
        <h3 class="text-sm font-semibold text-slate-700">Zakres prac</h3>
        <div class="mt-2 flex flex-wrap gap-2">
          ${selected.map((w) => `<span class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700">${w.label}</span>`).join('')}
        </div>
      </div>

      <div class="mt-6">
        <h3 class="text-base font-semibold text-slate-900">Narzędzia, które się przydadzą</h3>
        <ul class="mt-2 divide-y divide-slate-100">${toolsHtml}</ul>
      </div>

      <p class="mt-5 text-xs text-slate-400">
        * Szacunek na podstawie średnich stawek rynkowych. Ostateczny koszt zależy od lokalizacji,
        zakresu prac i wykonawcy.
      </p>
    `;
  }

  function update() {
    const roomId = roomSelect.value;
    const area = areaInput.value;
    const checkedStandard = form.querySelector('input[name="standard"]:checked');
    if (!checkedStandard) return;
    renderResult(calculate(roomId, area, checkedStandard.value));
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    update();
  });
  roomSelect.addEventListener('change', () => {
    renderWorks();
    update();
  });
  areaInput.addEventListener('input', update);
  form.querySelectorAll('input[name="standard"]').forEach((el) => el.addEventListener('change', update));
  worksEl.addEventListener('change', update);

  renderWorks();
  update();
</script>
