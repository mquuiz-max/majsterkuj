---
import Layout from '../layouts/Layout.astro';
import { rooms, standards, tools } from '../data/renovation';

const pageTitle = 'Kalkulator kosztów remontu';
const pageDescription =
  'Oblicz koszt remontu lub wykończenia pomieszczenia. Podaj metraż i standard, a otrzymasz kosztorys robocizny i materiałów oraz listę potrzebnych narzędzi.';
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      Kalkulator kosztów remontu
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-slate-600">
      Wybierz pomieszczenie, podaj metraż i standard wykończenia. Otrzymasz szacunkowy kosztorys
      (robocizna + materiały) oraz listę narzędzi, które przydadzą się do pracy.
    </p>

    <div class="mt-8 grid gap-8 lg:grid-cols-5">
      <form id="calculator" class="rounded-2xl border border-slate-200 bg-slate-50 p-6 lg:col-span-2">
        <label class="block text-sm font-semibold text-slate-700" for="room">1. Pomieszczenie</label>
        <select
          id="room"
          name="room"
          class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-200"
        >
          {rooms.map((room) => <option value={room.id}>{room.emoji} {room.name}</option>)}
        </select>

        <label class="mt-6 block text-sm font-semibold text-slate-700" for="area">2. Metraż (m²)</label>
        <input
          id="area"
          name="area"
          type="number"
          min="1"
          max="500"
          step="0.5"
          value="20"
          class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 focus:border-orange-500 focus:outline-none focus:ring-2 focus:ring-orange-200"
        />

        <fieldset class="mt-6">
          <legend class="text-sm font-semibold text-slate-700">3. Standard wykończenia</legend>
          <div class="mt-2 space-y-2">
            {standards.map((standard, i) => (
              <label class="flex cursor-pointer items-start gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2.5">
                <input type="radio" name="standard" value={standard.id} checked={i === 1} class="mt-1 accent-orange-600" />
                <span>
                  <span class="block text-sm font-medium text-slate-800">{standard.name}</span>
                  <span class="block text-xs text-slate-500">{standard.description}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <button
          type="submit"
          class="mt-6 w-full rounded-lg bg-orange-600 px-4 py-3 font-semibold text-white transition-colors hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-orange-400"
        >
          Oblicz koszt
        </button>
      </form>

      <div class="lg:col-span-3">
        <div id="result" class="rounded-2xl border border-slate-200 bg-white p-6">
          <p class="text-slate-500">Ładowanie…</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ rooms, standards, tools }}>
  const form = document.getElementById('calculator');
  const roomSelect = document.getElementById('room');
  const areaInput = document.getElementById('area');
  const resultEl = document.getElementById('result');

  const currency = new Intl.NumberFormat('pl-PL', {
    style: 'currency',
    currency: 'PLN',
    maximumFractionDigits: 0,
  });

  function toolById(id) {
    return tools.find((t) => t.id === id);
  }

  function calculate(roomId, area, standardId) {
    const room = rooms.find((r) => r.id === roomId);
    const standard = standards.find((s) => s.id === standardId);
    const areaNum = Number(area);
    if (!room || !standard || !areaNum || areaNum <= 0) return null;

    const costPerM2 = room.baseCostPerM2 * standard.multiplier;
    const mid = areaNum * costPerM2;
    const low = mid * 0.85;
    const high = mid * 1.15;
    const labor = mid * room.laborShare;
    const materials = mid * (1 - room.laborShare);
    const toolList = room.toolIds.map(toolById).filter(Boolean);

    return { room, standard, area: areaNum, low, high, labor, materials, toolList };
  }

  function renderResult(data) {
    if (!data) {
      resultEl.innerHTML =
        '<p class="text-slate-500">Podaj poprawny metraż (większy od 0), aby zobaczyć kosztorys.</p>';
      return;
    }

    const { room, standard, area, low, high, labor, materials, toolList } = data;

    const toolsHtml = toolList
      .map(
        (tool) => `
        <li class="flex items-center justify-between gap-4 border-b border-slate-100 py-3">
          <div>
            <p class="font-medium text-slate-800">${tool.name}</p>
            <p class="text-xs text-slate-500">${tool.category} · orientacyjnie ${tool.priceRange}</p>
          </div>
          <a
            href="${tool.affiliateUrl}"
            class="shrink-0 rounded-lg bg-orange-50 px-3 py-1.5 text-sm font-semibold text-orange-700 transition-colors hover:bg-orange-100"
          >
            Zobacz cenę
          </a>
        </li>`,
      )
      .join('');

    resultEl.innerHTML = `
      <div class="flex items-center gap-3">
        <span class="text-4xl" aria-hidden="true">${room.emoji}</span>
        <div>
          <h2 class="text-xl font-bold text-slate-900">Remont: ${room.name}</h2>
          <p class="text-sm text-slate-500">${area} m² · standard ${standard.name.toLowerCase()}</p>
        </div>
      </div>

      <div class="mt-5 rounded-xl bg-orange-50 p-5 text-center">
        <p class="text-sm font-medium text-orange-700">Szacunkowy koszt całkowity</p>
        <p class="mt-1 text-3xl font-bold text-slate-900">${currency.format(low)} – ${currency.format(high)}</p>
      </div>

      <div class="mt-5 grid grid-cols-2 gap-4">
        <div class="rounded-xl border border-slate-200 p-4">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Robocizna</p>
          <p class="mt-1 text-lg font-semibold text-slate-900">${currency.format(labor)}</p>
        </div>
        <div class="rounded-xl border border-slate-200 p-4">
          <p class="text-xs font-medium uppercase tracking-wide text-slate-500">Materiały</p>
          <p class="mt-1 text-lg font-semibold text-slate-900">${currency.format(materials)}</p>
        </div>
      </div>

      <div class="mt-5">
        <h3 class="text-sm font-semibold text-slate-700">Zakres prac</h3>
        <div class="mt-2 flex flex-wrap gap-2">
          ${room.scope.map((s) => `<span class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700">${s}</span>`).join('')}
        </div>
      </div>

      <div class="mt-6">
        <h3 class="text-base font-semibold text-slate-900">Narzędzia, które się przydadzą</h3>
        <ul class="mt-2 divide-y divide-slate-100">${toolsHtml}</ul>
      </div>

      <p class="mt-5 text-xs text-slate-400">
        * Szacunek na podstawie średnich stawek rynkowych. Ostateczny koszt zależy od lokalizacji,
        zakresu prac i wykonawcy.
      </p>
    `;
  }

  function update() {
    const roomId = roomSelect.value;
    const area = areaInput.value;
    const checkedStandard = form.querySelector('input[name="standard"]:checked');
    if (!checkedStandard) return;
    renderResult(calculate(roomId, area, checkedStandard.value));
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    update();
  });
  roomSelect.addEventListener('change', update);
  areaInput.addEventListener('input', update);
  form.querySelectorAll('input[name="standard"]').forEach((el) => el.addEventListener('change', update));

  update();
</script>
