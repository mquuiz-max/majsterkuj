---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---

<Layout title={article.data.title} description={article.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <header class="mb-8 border-b border-slate-100 pb-8">
      <p class="text-sm font-medium text-orange-600">{article.data.seoKeyword}</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        {article.data.title}
      </h1>
      <p class="mt-3 text-lg text-slate-600">{article.data.description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-slate-500">
        <time datetime={article.data.publishDate.toISOString()}>
          {article.data.publishDate.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        {article.data.readTime && <span>· {article.data.readTime} czytania</span>}
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        {article.data.tags.map((tag) => (
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-600">#{tag}</span>
        ))}
      </div>
    </header>

    <div class="article-body">
      <Content />
    </div>
  </article>
</Layout>
