---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { coverEmoji, articleImage } from '../../data/covers';
import { extractFaq, relatedArticles } from '../../lib/seo';
import { categoryFor } from '../../data/categories';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

const allArticles = await getCollection('articles');
const related = relatedArticles(allArticles, article, 3);
const faqItems = extractFaq(article.body);
const category = categoryFor(article.id);
const coverImage = articleImage(article.id) ?? category.image;

const siteUrl = 'https://majsterkuj.vercel.app';
const canonicalPath = `/poradniki/${article.id}/`;
const articleUrl = new URL(canonicalPath, siteUrl).href;
const publishDate = article.data.publishDate.toISOString();
const updatedDate = article.data.updatedDate
  ? article.data.updatedDate.toISOString()
  : publishDate;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.data.title,
  description: article.data.description,
  datePublished: publishDate,
  dateModified: updatedDate,
  author: { '@type': 'Organization', name: 'Majsterkuj', url: siteUrl },
  publisher: {
    '@type': 'Organization',
    name: 'Majsterkuj',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', siteUrl).href },
  },
  mainEntityOfPage: articleUrl,
  keywords: article.data.tags.join(', '),
  image: new URL('/og-image.svg', siteUrl).href,
  inLanguage: 'pl-PL',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Poradniki', item: new URL('/poradniki/', siteUrl).href },
    { '@type': 'ListItem', position: 3, name: article.data.title, item: articleUrl },
  ],
};

const schemaParts: unknown[] = [articleSchema, breadcrumbSchema];
if (faqItems.length > 0) {
  schemaParts.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  });
}
const schema = JSON.stringify(schemaParts);
---

<Layout
    title={article.data.title}
    description={article.data.description}
    canonicalPath={canonicalPath}
    ogType="article"
    schema={schema}
  >
  <article class="mx-auto max-w-3xl px-4 py-10">
    <nav aria-label="Nawigacja okruszkowa" class="text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="transition-colors hover:text-orange-600">Strona główna</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/poradniki/" class="transition-colors hover:text-orange-600">Poradniki</a></li>
        <li aria-hidden="true">›</li>
        <li><a href={`/kategorie/${category.id}/`} class="transition-colors hover:text-orange-600">{category.name}</a></li>
        <li aria-hidden="true">›</li>
        <li class="max-w-[16rem] truncate font-medium text-slate-700 sm:max-w-xs">{article.data.title}</li>
      </ol>
    </nav>
    {
      coverImage ? (
        <img
          src={coverImage}
          alt={category.name}
          class="mt-6 mb-8 h-48 w-full rounded-2xl object-cover"
          loading="lazy"
        />
      ) : (
        <div
          class="mt-6 mb-8 flex h-44 items-center justify-center rounded-2xl bg-gradient-to-br from-orange-100 via-amber-50 to-orange-50 text-8xl"
          aria-hidden="true"
        >
          {coverEmoji(article.id)}
        </div>
      )
    }
    <header class="mb-8 border-b border-slate-100 pb-8">
      <span class="inline-block rounded-full bg-orange-100 px-3 py-1 text-xs font-semibold text-orange-700">{article.data.seoKeyword}</span>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        {article.data.title}
      </h1>
      <p class="mt-3 text-lg text-slate-600">{article.data.description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-slate-500">
        <time datetime={article.data.publishDate.toISOString()}>
          {article.data.publishDate.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        {article.data.readTime && <span>· {article.data.readTime} czytania</span>}
        <span class="text-slate-400">· Autor: Redakcja Majsterkuj</span>
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        {article.data.tags.map((tag) => (
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-600">#{tag}</span>
        ))}
      </div>
    </header>

    <div class="article-body">
      <Content />
    </div>

    {
      related.length > 0 && (
        <section class="mt-12 border-t border-slate-100 pt-8">
          <h2 class="text-lg font-bold text-slate-900">Powiązane artykuły</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-3">
            {related.map((r) => (
              <a
                href={`/poradniki/${r.id}/`}
                class="group rounded-xl border border-slate-200 p-4 transition-colors hover:border-orange-200 hover:bg-orange-50/60"
              >
                <p class="text-xs font-medium text-orange-600">{r.data.seoKeyword}</p>
                <p class="mt-1.5 text-sm font-semibold leading-snug text-slate-900 group-hover:text-orange-600">
                  {r.data.title}
                </p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <div class="mt-8 rounded-2xl bg-gradient-to-r from-orange-50 to-amber-50 p-5">
      <p class="font-semibold text-slate-900">Planujesz remont?</p>
      <p class="mt-1 text-sm text-slate-600">
        Oblicz koszt w naszym kalkulatorze i sprawdź, jakie narzędzia będą Ci potrzebne.
      </p>
      <a
        href="/"
        class="mt-3 inline-block rounded-lg bg-orange-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-orange-700"
      >
        Otwórz kalkulator →
      </a>
    </div>
  </article>
</Layout>
