---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categories, categoryFor } from '../../data/categories';
import { coverEmoji } from '../../data/covers';

export async function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.id }, props: { category: c } }));
}

const { category } = Astro.props;

const articles = (await getCollection('articles'))
  .filter((a) => categoryFor(a.id).id === category.id)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout title={category.name} description={category.description} canonicalPath={`/kategorie/${category.id}/`}>
  <section class="mx-auto max-w-5xl px-4 py-10">
    <nav aria-label="Nawigacja okruszkowa" class="text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="transition-colors hover:text-orange-600">Strona główna</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/poradniki/" class="transition-colors hover:text-orange-600">Poradniki</a></li>
        <li aria-hidden="true">›</li>
        <li class="font-medium text-slate-700">{category.name}</li>
      </ol>
    </nav>

    <div class="mt-6 flex items-center gap-4">
      {category.image ? (
        <img src={category.image} alt={category.name} class="h-16 w-16 rounded-2xl object-cover" />
      ) : (
        <span class="flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-orange-100 to-amber-50 text-4xl" aria-hidden="true">
          {category.emoji}
        </span>
      )}
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{category.name}</h1>
        <p class="mt-1 text-slate-600">{category.description}</p>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap gap-2">
      {categories.map((c) => (
        <a
          href={`/kategorie/${c.id}/`}
          class={
            c.id === category.id
              ? 'rounded-full bg-orange-600 px-3 py-1 text-xs font-semibold text-white'
              : 'rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-600 transition-colors hover:bg-orange-100 hover:text-orange-700'
          }
        >
          {c.emoji} {c.name}
        </a>
      ))}
    </div>

    {
      articles.length > 0 ? (
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {articles.map((article) => (
            <a
              href={`/poradniki/${article.id}/`}
              class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-6 transition-all hover:-translate-y-1 hover:border-orange-200 hover:shadow-lg"
            >
              <span
                class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-orange-500 to-amber-500 opacity-0 transition-opacity group-hover:opacity-100"
                aria-hidden="true"
              ></span>
              {categoryFor(article.id).image ? (
                <img
                  src={categoryFor(article.id).image}
                  alt=""
                  class="mb-4 h-28 w-full rounded-xl object-cover"
                  loading="lazy"
                />
              ) : (
                <div
                  class="mb-4 flex h-20 items-center justify-center rounded-xl bg-gradient-to-br from-orange-100 via-amber-50 to-orange-50 text-4xl"
                  aria-hidden="true"
                >
                  {coverEmoji(article.id)}
                </div>
              )}
              <p class="text-xs font-semibold uppercase tracking-wide text-orange-600">{article.data.seoKeyword}</p>
              <h2 class="mt-2 text-lg font-bold text-slate-900 group-hover:text-orange-600">{article.data.title}</h2>
              <p class="mt-2 flex-1 text-sm text-slate-600">{article.data.description}</p>
              <div class="mt-4 flex items-center justify-between text-xs text-slate-500">
                <span class="flex items-center gap-3">
                  <time datetime={article.data.publishDate.toISOString()}>
                    {article.data.publishDate.toLocaleDateString('pl-PL')}
                  </time>
                  {article.data.readTime && <span>· {article.data.readTime} czytania</span>}
                </span>
                <span class="font-semibold text-orange-600 transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="mt-8 text-slate-500">Brak artykułów w tej kategorii.</p>
      )
    }
  </section>
</Layout>
